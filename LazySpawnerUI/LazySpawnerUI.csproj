<Project Sdk="Microsoft.NET.Sdk">
	<!-- LazySpawner's window and placement tool, built on the backend the same way any other mod would be. -->
	<PropertyGroup>
		<AssemblyName>LazySpawnerUI</AssemblyName>
		<KSPBT_GenerateVersionFile>false</KSPBT_GenerateVersionFile>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\LazySpawner\LazySpawner.csproj" KSPAssemblyName="LazySpawner" Private="false" />
		<Compile Include="..\LazySpawner\Logger.cs;..\LazySpawner\Meta.cs;..\LazySpawner\Localisation.cs" />
	</ItemGroup>
	<!-- Debug builds can be hot reloaded in game with HotReloadKSP. Reloading the backend reloads this too, so it uses the new one. -->
	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<AssemblyMetadata Include="HotReload" Value="true" />
	</ItemGroup>
</Project>
