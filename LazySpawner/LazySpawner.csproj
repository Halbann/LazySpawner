<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>LazySpawner</RootNamespace>
		<AssemblyName>LazySpawner</AssemblyName>
		<TargetFramework>net48</TargetFramework>
		<Version>0.3.0.0</Version>
		<LangVersion>latest</LangVersion>
		<Copyright>Copyright © Halban 2026, CC BY SA</Copyright>
	</PropertyGroup>
	<!-- General -->
	<PropertyGroup>
		<RepoRoot>$(SolutionDir)</RepoRoot>
	</PropertyGroup>
	<!-- KSPBT -->
	<PropertyGroup>
		<KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>
		<KSPBT_GenerateDependencyAttributes>false</KSPBT_GenerateDependencyAttributes>
	</PropertyGroup>
	<!-- Publicizer -->
	<ItemGroup>
		<Publicize Include="Assembly-CSharp" />
	</ItemGroup>
	<!-- Debug builds can be hot reloaded in game with HotReloadKSP. -->
	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<AssemblyMetadata Include="HotReload" Value="true" />
	</ItemGroup>
	<!-- Version Files -->
	<ItemGroup>
		<KSPVersionFile Include="$(RepoRoot)LazySpawner.version">
			<KSP_Version_Min>1.12</KSP_Version_Min>
			<Destination>$(KSPBT_ModRoot)/LazySpawner.version</Destination>
		</KSPVersionFile>
	</ItemGroup>
	<!-- Packages -->
	<ItemGroup>
		<PackageReference Include="KSPBuildTools" Version="1.1.1" />
		<PackageReference Include="Krafs.Publicizer" Version="2.3.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<!-- Copy text files -->
	<Target Name="CopyTextFiles" AfterTargets="Build" BeforeTargets="CopyToGame">
		<Copy SourceFiles="$(RepoRoot)README.md" DestinationFiles="$(KSPBT_ModRoot)Readme.txt" />
		<Copy SourceFiles="$(RepoRoot)LICENSE.md" DestinationFiles="$(KSPBT_ModRoot)License.txt" />
	</Target>
	<!-- Copy mod folder to game -->
	<!-- After the version file is generated, so the game gets the fresh one. -->
	<Target Name="CopyToGame" AfterTargets="Build;KSPBT_GenerateVersionFile">
		<ItemGroup>
			<ModFiles Include="$(KSPBT_ModRoot)\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(ModFiles)" DestinationFiles="@(ModFiles->'$(KSPBT_GameRoot)/GameData/$(MSBuildProjectName)/%(RecursiveDir)%(Filename)%(Extension)')" />
	</Target>
</Project>
